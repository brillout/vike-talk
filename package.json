{
  "type": "module",
  "scripts": {
    "dev": "vike dev",
    "build": "vike build",
    "preview": "vike preview",
    "========= Slide Management": "",
    "slides:insert": "pnpm node-ts scripts/manage-slides.ts insert",
    "slides:remove": "pnpm node-ts scripts/manage-slides.ts remove",
    "slides:move": "pnpm node-ts scripts/manage-slides.ts move",
    "slides:add": "pnpm node-ts scripts/manage-slides.ts add",
    "slides:list": "pnpm node-ts scripts/manage-slides.ts list",
    "slides:help": "pnpm node-ts scripts/manage-slides.ts",
    "team:fetch": "pnpm node-ts scripts/fetch-team.ts",
    "// Run a .ts file with Node.js — flags aren't needed on Node.js 24+": "",
    "node-ts": "node --experimental-strip-types --no-warnings=ExperimentalWarning",
    "========= Formatting": "",
    "format": "oxfmt",
    "========= Reset": "",
    "reset": "git clean -Xdf && pnpm install && pnpm run build",
    "========= Only allow pnpm; forbid yarn & npm": "",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@brillout/shell": "^0.2.2",
    "@brillout/shiki-transformers": "^4.0.2",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/transformers": "^4.0.2",
    "@types/node": "^25.6.2",
    "@types/opentype.js": "^1.3.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "opentype.js": "^2.0.0",
    "oxfmt": "^0.48.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rehype-pretty-code": "^0.14.3",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "typescript": "^6.0.3",
    "vike": "^0.4.259",
    "vike-react": "^0.6.21",
    "vite": "^8.0.11"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "flubber": "^0.4.2",
    "motion": "^12.38.0"
  }
}
