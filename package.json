{
  "type": "module",
  "scripts": {
    "dev": "vike dev",
    "build": "vike build",
    "preview": "vike preview",
    "========= Formatting": "",
    "format": "biome check --write --unsafe",
    "format:check": "biome ci && echo '\\033[1;32mFormatting is correct.\\033[0m' || (echo '\\033[1;34mFix formatting by running `$ pnpm run format`.\\033[0m' && exit 1)",
    "========= Slide Management": "",
    "slides:insert": "node scripts/manage-slides.js insert",
    "slides:remove": "node scripts/manage-slides.js remove",
    "slides:move": "node scripts/manage-slides.js move",
    "slides:add": "node scripts/manage-slides.js add",
    "slides:list": "node scripts/manage-slides.js list",
    "slides:help": "node scripts/manage-slides.js",
    "========= Reset": "",
    "reset": "git clean -Xdf && pnpm install && pnpm run build",
    "========= Only allow pnpm; forbid yarn & npm": "",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/transformers": "^4.0.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "playwright": "^1.58.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-pretty-code": "^0.14.3",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "typescript": "^6.0.2",
    "vike": "^0.4.255",
    "vike-react": "^0.6.21",
    "vite": "^8.0.3"
  },
  "dependencies": {
    "@brillout/shiki-transformers": "^4.0.2"
  }
}
